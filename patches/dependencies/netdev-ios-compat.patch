             return Ipv6AddrFlags::default();
         }
 
-        let mut req: libc::in6_ifreq = std::mem::zeroed();
+        let mut req: In6Ifreq = std::mem::zeroed();
 
         let name_bytes = ifname.as_bytes();
         let copy_len = name_bytes.len().min(libc::IFNAMSIZ - 1);
