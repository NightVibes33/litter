+            description: REALTIME_V2_SILENCE_TOOL_DESCRIPTION.to_string(),
+            parameters: json!({
+                "type": "object",
+                "properties": {},
+                "additionalProperties": false
+            }),
+        },
+    ];
+    if let Some(dynamic_tools) = dynamic_tools {
+        for tool in dynamic_tools {
+            match tool {
+                DynamicToolSpec::Function(tool) => tools.push(SessionFunctionTool {
+                    r#type: SessionToolType::Function,
+                    name: tool.name,
+                    description: tool.description,
+                    parameters: tool.input_schema,
+                }),
+                DynamicToolSpec::Namespace(namespace) => {
+                    for tool in namespace.tools {
+                        let DynamicToolNamespaceTool::Function(tool) = tool;
+                        tools.push(SessionFunctionTool {
+                            r#type: SessionToolType::Function,
+                            name: format!("{}{}", namespace.name, tool.name),
+                            description: tool.description,
+                            parameters: tool.input_schema,
+                        });
+                    }
+                }
+            }
+        }
+    }
+    tools
