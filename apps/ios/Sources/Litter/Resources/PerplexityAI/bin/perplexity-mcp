#!/bin/sh
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../upstream" && pwd)"
if [ -z "${PERPLEXITY_COOKIES:-}" ] && [ -n "${PERPLEXITY_COOKIES_FILE:-}" ] && [ -f "$PERPLEXITY_COOKIES_FILE" ]; then
  PERPLEXITY_COOKIES="$(cat "$PERPLEXITY_COOKIES_FILE")"
  export PERPLEXITY_COOKIES
fi
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m perplexity.mcp "$@"
