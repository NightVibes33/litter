#!/usr/bin/env python3
import json
import os
import sys

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'upstream'))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from perplexity import Client

def load_cookies():
    raw = os.environ.get('PERPLEXITY_COOKIES', '').strip()
    if raw:
        return json.loads(raw)
    path = os.environ.get('PERPLEXITY_COOKIES_FILE', os.path.expanduser('~/.config/alley-cat/perplexity-cookies.json'))
    if os.path.exists(path):
        with open(path, 'r', encoding='utf-8') as handle:
            return json.load(handle)
    return {}

def main():
    if len(sys.argv) < 2:
        print('Usage: perplexity-chat "question" [mode] [model]', file=sys.stderr)
        print('Modes: auto, pro, reasoning, deep research', file=sys.stderr)
        return 2
    stream = '--stream' in sys.argv
    if stream:
        sys.argv.remove('--stream')
    query = sys.argv[1]
    mode = sys.argv[2] if len(sys.argv) > 2 else os.environ.get('PERPLEXITY_MODE', 'auto')
    model = sys.argv[3] if len(sys.argv) > 3 else os.environ.get('PERPLEXITY_MODEL')
    if model == '' or model == 'default':
        model = None
    client = Client(load_cookies())
    response = client.search(query, mode=mode, model=model, stream=stream)
    if stream:
        for chunk in response:
            print(json.dumps(chunk), flush=True)
    elif isinstance(response, dict):
        print(response.get('answer') or json.dumps(response, indent=2))
    else:
        print(response)
    return 0

if __name__ == '__main__':
    raise SystemExit(main())
