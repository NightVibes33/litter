[submodule "shared/third_party/codex"]
	path = shared/third_party/codex
	url = https://github.com/NightVibes33/codex.git
	shallow = true
[submodule "shared/third_party/ghostty"]
	path = shared/third_party/ghostty
	url = https://github.com/ghostty-org/ghostty.git
	shallow = true
[submodule "ThirdParty/SideStore/AltSign"]
	path = ThirdParty/SideStore/AltSign
	url = https://github.com/SideStore/AltSign.git
	branch = master
[submodule "ThirdParty/EmexDE/Source"]
	path = ThirdParty/EmexDE/Source
	url = https://github.com/emexlab/Nyxian.git
	branch = main
	shallow = true

# Current official SideStore code kept separate from the customized Alley Cat
# compatibility snapshot until a tested adapter replaces AltStoreCore.
[submodule "ThirdParty/SideStore/Upstream"]
	path = ThirdParty/SideStore/Upstream
	url = https://github.com/SideStore/SideStore.git
	branch = develop
	shallow = true
